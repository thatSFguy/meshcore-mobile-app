<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE permissions (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Bluetooth on pre-Android-12 (BLE scan/connect legacy permission). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                     android:maxSdkVersion="30" />
    <!-- Pre-12 BLE scanning requires location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
                     android:maxSdkVersion="30" />

    <!-- Foreground service holding the BLE/USB/TCP radio link. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- dataSync FGS type for TCP-only connections: connectedDevice requires
         a granted Bluetooth runtime permission on Android 14+, which a
         TCP-only user who denied BLE doesn't have (carried over from
         reticulum-mobile-app issue #35). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network: TCP transport (off by default) + map tiles — the only
         outbound-HTTP feature (SCOPE.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR scanning (contact import, channel/community join). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- USB host for a USB-attached MeshCore radio. Not required so the
         app still installs on phones without USB-OTG. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
        Auto Backup disabled: the app stores the node identity seed and
        (via Room) message history; secrets live in the Android Keystore
        but backup of the DB alone is still unwanted cloud exfiltration
        of message content. Same reasoning as reticulum-mobile-app
        (its audit HIGH-1).
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshCore">

        <!-- taskAffinity="" — StrandHogg-class task-injection hardening,
             carried over from reticulum-mobile-app (its audit L6). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboard|keyboardHidden"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QR scanner pinned to portrait (zxing-android-embedded). -->
        <activity
            android:name=".platform.PortraitCaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:exported="false"
            android:theme="@style/zxing_CaptureTheme" />

        <service
            android:name=".service.MeshCoreService"
            android:foregroundServiceType="connectedDevice|dataSync"
            android:exported="false" />

        <!-- Scoped FileProvider for the GPX export share sheet: only
             cache/exports/ is exposed, read-only, per-share grants. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
